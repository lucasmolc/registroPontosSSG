<Window x:Class="RegistroPontosSSG.Desktop.Views.VerboseLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logs detalhados — Execução"
        Height="720" Width="1100" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Logs detalhados" Style="{StaticResource Display}" FontSize="18"/>
                <TextBlock Style="{StaticResource Subtitle}">
                    Cada clique, preenchimento e seletor utilizado pela automação. Útil para diagnosticar erros de execução.
                </TextBlock>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource AccentBadge}" VerticalAlignment="Center">
                <TextBlock>
                    <Run Text="{Binding ElementName=LogList, Path=Items.Count, Mode=OneWay}"
                         Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                    <Run Text=" linha(s)" Foreground="{StaticResource TextMuted}"/>
                </TextBlock>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="📋  Copiar tudo" Click="Copy_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="💾  Salvar como..." Click="Save_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="📂  Abrir pasta de logs" Click="OpenFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="🗑  Limpar" Click="Clear_Click" Style="{StaticResource DangerButton}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource ConsoleBg}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12">
            <ListBox x:Name="LogList"
                     FontFamily="{StaticResource FontMono}" FontSize="12"
                     Foreground="{StaticResource ConsoleText}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{StaticResource ConsoleText}"
                                   FontFamily="{StaticResource FontMono}" FontSize="12"
                                   TextWrapping="NoWrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <CheckBox x:Name="AutoScrollCheck" Content="Rolagem automática" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Fechar" Click="Close_Click" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
