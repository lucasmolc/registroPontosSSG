<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RegistroPontosSSG.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permite que os testes exercitem membros internos (validacao do download e
         geracao do script de troca do executavel), sem torna-los API publica. -->
    <InternalsVisibleTo Include="RegistroPontosSSG.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- O CHANGELOG.md da raiz é embutido no assembly para que o app mostre o resumo
         da versão na primeira execução após atualizar, mesmo sem rede. O nome do
         recurso fica "RegistroPontosSSG.Core.CHANGELOG.md" (ver ChangelogReader). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="RegistroPontosSSG.Core.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.54.0" />
    <PackageReference Include="Otp.NET" Version="1.4.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
