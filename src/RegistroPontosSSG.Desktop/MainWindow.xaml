<Window x:Class="RegistroPontosSSG.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RegistroPontosSSG.Desktop.ViewModels"
        Title="Registro Automático de Pontos SSG"
        Icon="Assets/logo.ico"
        Height="760" Width="1080" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
    </Window.Resources>

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- faixa de aviso de nova versão -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═════════ Header ═════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo mark -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                    Background="{StaticResource AccentSubtle}" VerticalAlignment="Center">
                <TextBlock Text="⏱" FontSize="22" Foreground="{StaticResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Registro Automático de Pontos SSG" Style="{StaticResource Display}"/>
                <TextBlock Text="Configure suas credenciais e o arquivo de pontos, depois execute."
                           Style="{StaticResource Subtitle}"/>
            </StackPanel>

            <!-- Status pill -->
            <Border Grid.Column="2" Style="{StaticResource AccentBadge}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Status}" Margin="8,0,0,0" Foreground="{StaticResource Text}" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═════════ Aviso de nova versão ═════════ -->
        <Border Grid.Row="1" Margin="0,0,0,18" CornerRadius="10" Padding="16,12"
                Background="{StaticResource AccentSubtle}"
                BorderBrush="{StaticResource Accent}" BorderThickness="1"
                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolParaVisibilidade}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🆕" FontSize="18" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateMessage}" Foreground="{StaticResource Text}"
                               FontSize="13" TextWrapping="Wrap"/>
                    <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding UpdateProgress}"
                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolParaVisibilidade}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Ver notas" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenReleasePageCommand}" Margin="0,0,8,0"/>
                    <!-- O comando ignora cliques repetidos enquanto o download roda. -->
                    <Button Content="Atualizar agora" Command="{Binding InstallUpdateCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════ Tabs ═════════ -->
        <TabControl Grid.Row="2">

            <!-- ─── TAB 1: Credenciais ─── -->
            <TabItem Header="🔐  Credenciais">
                <Grid Margin="28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Coluna 1: login -->
                    <Border Grid.Column="0" Style="{StaticResource SubCard}">
                        <StackPanel>
                            <TextBlock Text="Acesso ao SSG" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="USUÁRIO" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Geralmente o início do seu e-mail corporativo" Style="{StaticResource Hint}"/>

                            <TextBlock Text="SENHA" Style="{StaticResource Label}" Margin="0,8,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox Grid.Column="0" x:Name="PasswordBox"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>
                                <TextBox Grid.Column="0" x:Name="PasswordTextBox"
                                         Visibility="Collapsed"
                                         TextChanged="PasswordTextBox_TextChanged"/>
                                <Button Grid.Column="1" x:Name="TogglePasswordButton"
                                        Content="👁" Width="40" Margin="6,0,0,0"
                                        ToolTip="Mostrar/ocultar senha"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="TogglePassword_Click"/>
                            </Grid>
                            <TextBlock Text="Armazenada criptografada via Windows DPAPI — vinculada à sua conta."
                                       Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>

                    <!-- Coluna 2: 2FA -->
                    <Border Grid.Column="2" Style="{StaticResource SubCard}">
                        <StackPanel>
                            <TextBlock Text="Autenticação 2FA" Style="{StaticResource SectionTitle}"/>

                            <Border Background="{StaticResource Bg}" CornerRadius="8"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="STATUS" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding TotpStatus}" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Configurar 2FA" Command="{Binding OpenTotpWizardCommand}" Margin="0,0,10,0"/>
                                <Button Content="Remover" Command="{Binding ClearTotpCommand}" Style="{StaticResource DangerButton}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0">
                                Sem 2FA configurado, o navegador é aberto e você digita o código manualmente no Authenticator.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── TAB 2: Arquivo de Pontos ─── -->
            <TabItem Header="📂  Arquivo de Pontos">
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SubCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="📁  Selecionar arquivo" Command="{Binding BrowseFileCommand}"/>

                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <TextBlock Text="ARQUIVO ATUAL" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding FilePath, FallbackValue='Nenhum arquivo selecionado'}"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}"/>
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource AccentBadge}" VerticalAlignment="Center">
                                <TextBlock>
                                    <Run Text="{Binding Records.Count, Mode=OneWay}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                    <Run Text=" registro(s)" Foreground="{StaticResource TextMuted}"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,0,0,12">
                        Aceita planilhas Excel (.xlsx), CSV ou relatórios exportados do próprio SSG — detecção automática de formato.
                    </TextBlock>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn Header="Entrada" Binding="{Binding Entry}" Width="*"/>
                            <DataGridTextColumn Header="Saída Almoço" Binding="{Binding LunchOut}" Width="*"/>
                            <DataGridTextColumn Header="Retorno Almoço" Binding="{Binding LunchReturn}" Width="*"/>
                            <DataGridTextColumn Header="Saída" Binding="{Binding Exit}" Width="*"/>
                            <DataGridTextColumn Header="Observação" Binding="{Binding Notes}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ─── TAB 3: Regras ─── -->
            <TabItem Header="⚙️  Regras">
                <Grid Margin="28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource SubCard}">
                        <StackPanel>
                            <TextBlock Text="Validações de horário" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,-8,0,12">
                                Ajustes aplicados automaticamente antes de enviar para o SSG.
                            </TextBlock>

                            <CheckBox IsChecked="{Binding BlockRoundTimes}"
                                      Content="Bloquear horários redondos (08:00 → 08:01)" Margin="0,8"/>
                            <CheckBox IsChecked="{Binding BlockExactOneHourLunch}"
                                      Content="Bloquear almoço de exatamente 1h" Margin="0,8"/>
                            <CheckBox IsChecked="{Binding BlockSameMinutes}"
                                      Content="Bloquear minutos iguais no mesmo dia (ex.: 09:58 e 12:58)" Margin="0,8"/>
                            <CheckBox IsChecked="{Binding BlockDuplicates}"
                                      Content="Bloquear horários duplicados em dias próximos" Margin="0,8"/>

                            <Border Style="{StaticResource SubCard}" Background="{StaticResource Bg}"
                                    Margin="28,8,0,0" IsEnabled="{Binding BlockDuplicates}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Dias para verificar duplicados:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}"/>
                                    <TextBox Text="{Binding DaysToCheckDuplicates}" Width="80" Margin="12,0,0,0"
                                             HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource SubCard}">
                        <StackPanel>
                            <TextBlock Text="Automação do navegador" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,-8,0,12">
                                Como o Playwright se conecta ao navegador.
                            </TextBlock>

                            <CheckBox IsChecked="{Binding UseSystemChrome}"
                                      Content="Usar Chrome instalado no sistema (recomendado — Cloudflare)" Margin="0,8"/>
                            <CheckBox IsChecked="{Binding IgnoreExistingDates}"
                                      Content="Ignorar datas já cadastradas no SSG" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="1" Grid.ColumnSpan="3" Content="💾  Salvar configurações"
                            Command="{Binding SaveConfigCommand}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Margin="0,20,0,0"/>
                </Grid>
            </TabItem>

            <!-- ─── TAB 4: Executar ─── -->
            <TabItem Header="▶️  Executar">
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SubCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🚀  Executar registro"
                                    Command="{Binding RunCommand}" Style="{StaticResource HeroButton}"/>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="STATUS ATUAL" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Text}" FontSize="14"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="🔍  Logs detalhados"
                                    Command="{Binding OpenVerboseLogCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Abre uma janela com o log verboso de cada ação (clique, preenchimento, seletor) durante a execução."
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource ConsoleBg}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="LOG DE EXECUÇÃO" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>

                            <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                                     FontFamily="{StaticResource FontMono}" FontSize="12"
                                     Foreground="{StaticResource ConsoleText}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <StaticResource ResourceKey="LogItem"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}"
                                                   Foreground="{StaticResource ConsoleText}"
                                                   FontFamily="{StaticResource FontMono}" FontSize="12"
                                                   TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═════════ Footer ═════════ -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       TextWrapping="Wrap">
                Configurações salvas em %APPDATA%\RegistroPontosSSG\config.json — senha e secret TOTP criptografadas via Windows DPAPI.
                Atualizar o aplicativo não afeta esses dados.
            </TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <CheckBox Content="Verificar atualizações ao iniciar"
                          IsChecked="{Binding CheckUpdatesOnStartup}" VerticalAlignment="Center"/>
                <Button Content="Verificar agora" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                        Command="{Binding CheckForUpdatesCommand}"/>
                <TextBlock Text="{Binding AppVersionLabel}" Style="{StaticResource Hint}"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
