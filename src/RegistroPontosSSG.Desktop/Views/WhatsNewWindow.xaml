<Window x:Class="RegistroPontosSSG.Desktop.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novidades desta versão"
        Icon="../Assets/logo.ico"
        Height="560" Width="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TituloTexto" Text="O que mudou" Style="{StaticResource Display}"/>
            <TextBlock x:Name="SubtituloTexto" Style="{StaticResource Subtitle}"
                       Text="Resumo das alterações desta atualização."/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="10" Padding="18,16"
                Background="{StaticResource Surface}" BorderThickness="1"
                BorderBrush="{StaticResource Border}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ConteudoTexto" TextWrapping="Wrap"
                           Foreground="{StaticResource Text}" FontSize="13" LineHeight="20"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Ver no GitHub" Click="AbrirGitHub_Click" Margin="0,0,10,0"/>
            <Button Content="Fechar" IsDefault="True" IsCancel="True" Click="Fechar_Click"/>
        </StackPanel>
    </Grid>
</Window>
